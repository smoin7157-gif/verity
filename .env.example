# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Bypasses row-level security; used by the commit sync to write
# public.commits. Never expose this as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only GitHub personal access token with public repo read access.
# Raises the GitHub API limit from 60 to 5,000 requests per hour.
GITHUB_TOKEN=github_pat_your_token

# Shared secret for /api/cron/sync. Vercel Cron sends it as a Bearer token.
CRON_SECRET=replace-with-a-long-random-string
